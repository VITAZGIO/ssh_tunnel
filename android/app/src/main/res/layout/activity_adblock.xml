<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/c_bg"
    android:padding="16dp">

    <LinearLayout style="@style/HeadRow">
        <ImageView
            android:id="@+id/backFromAdBlock"
            style="@style/HeadIcon"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back" />

        <TextView style="@style/HeadTitle" android:text="@string/ad_block_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/adBlockEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/c_text"
                android:text="@string/ad_block_enabled" />

            <TextView
                android:id="@+id/tileBlocked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:paddingBottom="8dp"
                android:textSize="12.5sp"
                android:textColor="?attr/c_dim" />

            <!-- Две вкладки, как в «Исключениях доменов»: список блокировки и
                 список исключений — оба применяются одновременно. -->
            <LinearLayout
                android:id="@+id/abTabs"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_outline"
                android:showDividers="middle"
                android:divider="@drawable/bg_seg_div">
                <TextView style="@style/SegItem" android:tag="block" android:text="@string/ad_block_tab_block" />
                <TextView style="@style/SegItem" android:tag="allow" android:text="@string/ad_block_tab_allow" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tabLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="?attr/c_dim" />
                <TextView
                    style="@style/InfoQ"
                    android:id="@+id/tabInfo" />
            </LinearLayout>

            <EditText
                android:id="@+id/listEdit"
                style="@style/Field"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minLines="7"
                android:gravity="top"
                android:textColorHint="?attr/c_dim"
                android:autofillHints="" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView style="@style/SectTitle" android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp" android:text="@string/domains_xfer" />
                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <LinearLayout
                    android:id="@+id/xferModeSeg"
                    style="@style/XferSeg">
                    <TextView style="@style/XferSegItem" android:tag="clip" android:text="@string/xfer_clip" />
                    <TextView style="@style/XferSegItem" android:tag="file" android:text="@string/xfer_file" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_outline"
                android:showDividers="middle"
                android:divider="@drawable/bg_seg_div">
                <TextView android:id="@+id/abImportBtn" style="@style/SegItem" android:text="@string/import_short" />
                <TextView android:id="@+id/abExportBtn" style="@style/SegItem" android:text="@string/export_short" />
            </LinearLayout>
            <TextView
                android:id="@+id/adBlockStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="12.5sp"
                android:textColor="?attr/c_dim" />

            <!-- «Сохранить» и скачивает списки по ссылкам: отдельная кнопка
                 «Обновить список» больше не нужна. -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/saveAdBlock"
                style="@style/PrimaryButton"
                android:layout_marginTop="22dp"
                android:text="@string/save" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
