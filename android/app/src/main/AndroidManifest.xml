<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
        Начиная с Android 14 у постоянной службы обязан быть объявлен тип.
        Для приложений, которые работают через VpnService, предусмотрен
        специальный тип: обычные (воспроизведение, синхронизация и прочие)
        сюда не подходят по смыслу.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Начиная с Android 13 уведомление нельзя показать без разрешения. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Список установленных приложений нужен для экрана исключений. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Только чтобы отсканировать QR с настройками — приложение не снимает
         фото и не пишет видео, само разрешение спрашивается по нажатию. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Скачанное обновление открывается сразу в установщике: без этого
         разрешения Android даже не предложит разрешить установку. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- «Файлы устройства»: другие устройства сети смотрят папки, которые
         владелец сам отметил (Фото, Загрузки…). Ядро на Go работает с путями,
         поэтому нужен «Доступ ко всем файлам», а не SAF; спрашивается по
         кнопке в приложении. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Календарь (ТЗ 7): события Nextcloud в системный календарь, по
         галочке — контакты. Спрашиваются при подключении календаря. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Долгое нажатие на кнопку в шторке: без этого система открывает
                 страницу приложения в своих настройках, а не саму программу. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <!-- Ссылка импорта сервера из панели (её же несёт QR при создании
                 клиента): камера или браузер открывают её в приложении. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sshtunnel" android:host="import" />
            </intent-filter>
        </activity>

        <!-- Общие с ПК страницы: Книга и дополнительные приложения. -->
        <activity
            android:name=".WebPageActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!-- Экран сканера QR из zxing-android-embedded: по умолчанию у него
             fullSensor, из-за чего при повороте телефона картинка с камеры
             уезжает в альбомную ориентацию — неудобно держать при сканировании
             одной рукой. Портрет всегда. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="screenOrientation" />

        <!--
            Кнопка в шторке быстрых настроек. Разрешение выдаёт система: с ним
            запускать её может только она сама.
        -->
        <service
            android:name=".TunnelTile"
            android:exported="true"
            android:icon="@drawable/ic_notify"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
            Служба туннеля. Разрешение BIND_VPN_SERVICE выдаёт система, и
            благодаря ему запустить службу может только она сама — после того,
            как человек подтвердил запрос на создание VPN-подключения.

            android.net.VpnService intent-filter — по нему система находит эту
            службу в списке «Всегда включённый VPN» (Настройки → Сеть → VPN →
            шестерёнка). SUPPORTS_ALWAYS_ON=true объявлен явно, хотя это и так
            значение по умолчанию: без него сюда же попадает и режим
            «Блокировать соединения без VPN» — оба переключаются в одном месте
            системных настроек, отдельно объявлять второй не нужно.

            Собственного «выключателя» на утечку трафика мимо туннеля здесь
            нет и не должно быть: система уже гарантирует его сама в режиме
            блокировки, а свой — это лишний код и лишний повод ошибиться.
            TunnelService.startTunnel читает последний сохранённый профиль
            прямо из SharedPreferences, поэтому запуск системой без открытия
            приложения (ровно так стартует always-on VPN после перезагрузки)
            поднимает туннель с теми же настройками, что были в последний раз.
        -->
        <service
            android:name=".TunnelService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
        </service>
        <!-- Календарь (CalendarSync.kt): свой аккаунт, SyncAdapter календаря и
             контактов (система будит его раз в 15 минут и после
             перезагрузки), виджет главного экрана. -->
        <service
            android:name=".CalendarAuthService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/calendar_authenticator" />
        </service>
        <service
            android:name=".CalendarSyncService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/calendar_syncadapter" />
        </service>
        <!-- Тот же SyncAdapter для контактов: у каждого authority — своё описание. -->
        <service
            android:name=".ContactsSyncService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/contacts_syncadapter" />
        </service>
        <receiver
            android:name=".CalendarWidget"
            android:exported="false"
            android:label="@string/calendar_account">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calendar_widget_info" />
        </receiver>
        <!-- Скачанное обновление отдаётся установщику через FileProvider. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>
</manifest>
